#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/render.sh"
source "$SCRIPT_DIR/lib/commands.sh"

usage() {
  cat <<'EOF'
Usage: nodes [command] [options]

Run without a command for the guided workflow.

Commands:
  provision [physical|cloud]  Provision a node
  remove                      Drain and delete a cloud node
  sync HOSTNAME...            Update existing nodes
  help                        Show this help
EOF
}

provision_command() {
  local target="${1:-}"

  if [[ "$target" == "--help" || "$target" == "-h" ]]; then
    cat <<'EOF'
Usage: nodes provision [physical|cloud] [options]

Choose a target interactively or use:
  nodes provision physical --help
  nodes provision cloud --help
EOF
    return
  fi

  if [[ "$target" == "physical" || "$target" == "cloud" ]]; then
    shift
  elif [[ -n "$target" && "$target" != --* ]]; then
    die "target must be 'physical' or 'cloud'"
  else
    read -r -p "Target (physical/cloud): " target
  fi

  case "$target" in
    physical)
      flash_command "$@"
      ;;
    cloud)
      up_command "$@"
      ;;
    *)
      die "target must be 'physical' or 'cloud'"
      ;;
  esac
}

COMMAND_ARGS=()
if [[ $# -eq 0 ]]; then
  cat <<'EOF'
What would you like to do?

  1) Provision a physical node
  2) Provision a cloud node
  3) Remove a cloud node
  4) Sync existing nodes
EOF
  choice=""
  read -r -p "Select [1-4]: " choice
  case "$choice" in
    1)
      COMMAND=provision
      COMMAND_ARGS=(physical)
      ;;
    2)
      COMMAND=provision
      COMMAND_ARGS=(cloud)
      ;;
    3)
      COMMAND=remove
      ;;
    4)
      COMMAND=sync
      hostnames=""
      read -r -p "Hostnames: " hostnames
      read -r -a COMMAND_ARGS <<< "$hostnames"
      ;;
    *)
      die "invalid selection"
      ;;
  esac
else
  COMMAND="$1"
  shift
  COMMAND_ARGS=("$@")
fi

case "$COMMAND" in
  provision)
    provision_command "${COMMAND_ARGS[@]}"
    ;;
  remove|down)
    down_command "${COMMAND_ARGS[@]}"
    ;;
  sync)
    sync_command "${COMMAND_ARGS[@]}"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    usage >&2
    die "unknown command '$COMMAND'"
    ;;
esac

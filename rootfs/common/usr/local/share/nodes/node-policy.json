{
  "version": 1,
  "timezone": "Europe/Lisbon",
  "users": {
    "pi": {
      "groups": ["adm", "sudo"],
      "shell": "/bin/bash",
      "sudo": "ALL=(ALL) NOPASSWD:ALL"
    }
  },
  "root": {"password": "!", "expire": false},
  "packages": {
    "common": ["chrony", "curl", "jq", "nfs-common", "nfs-kernel-server", "open-iscsi", "unattended-upgrades"],
    "physical": ["bluez", "iw", "linux-firmware-realtek", "wpasupplicant"],
    "nvidia": ["linux-modules-nvidia-580-server-generic", "nvidia-headless-no-dkms-580-server", "nvidia-utils-580-server", "nvidia-container-toolkit"]
  },
  "apt": {
    "package_update": true,
    "package_upgrade": true,
    "conf": {
      "Acquire::Retries": "5",
      "APT::Periodic::Update-Package-Lists": "1",
      "APT::Periodic::AutocleanInterval": "5",
      "APT::Periodic::Unattended-Upgrade": "1",
      "APT::Periodic::Verbose": "1",
      "Unattended-Upgrade::Remove-Unused-Dependencies": "true",
      "Unattended-Upgrade::Remove-New-Unused-Dependencies": "true",
      "Unattended-Upgrade::AutoFixInterruptedDpkg": "true"
    }
  },
  "swap": {"size": 0},
  "network": {
    "version": 2,
    "ethernet": {
      "id": "ethernet",
      "match_name": "e*",
      "dhcp4": true,
      "optional": true,
      "route_metric": 200
    },
    "wifi": {
      "interface": "wlan0",
      "dhcp4": true,
      "optional": true,
      "route_metric": 600,
      "key_management": "psk"
    },
    "profiles": {
      "fraguinha": {
        "ethernets": {
          "eth0": {
            "dhcp4": false,
            "optional": true,
            "addresses": ["192.168.68.64/22"],
            "nameservers": {"addresses": ["1.1.1.1", "1.0.0.1"]},
            "routes": [{"to": "default", "via": "192.168.68.1", "metric": 100}]
          }
        },
        "wifis": {
          "wlan0": {"dhcp4": true, "optional": true, "dhcp4-overrides": {"route-metric": 600}}
        }
      },
      "carolion": {
        "ethernets": {
          "ethernet": {"match": {"name": "e*"}, "dhcp4": true, "optional": true, "dhcp4-overrides": {"route-metric": 200}}
        },
        "wifis": {
          "wlan0": {
            "dhcp4": false,
            "optional": true,
            "addresses": ["192.168.68.68/22"],
            "nameservers": {"addresses": ["1.1.1.1", "1.0.0.1"]},
            "routes": [{"to": "default", "via": "192.168.68.1", "metric": 100}]
          }
        }
      },
      "livinvicta": {
        "ethernets": {
          "eth0": {"dhcp4": true, "optional": true, "dhcp4-overrides": {"route-metric": 200}}
        },
        "wifis": {
          "wlan0": {"dhcp4": true, "optional": true, "dhcp4-overrides": {"route-metric": 600}}
        }
      }
    }
  }
}
